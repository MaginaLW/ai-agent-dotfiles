{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/artifact-validation-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "ArtifactKind", "GeneratedAtUtc", "Artifacts"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "ArtifactKind": { "const": "artifact-validation-manifest" },
    "GeneratedAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "Artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ArtifactKind", "SchemaVersion", "Path", "Sha256"],
      "properties": {
        "ArtifactKind": { "type": "string", "minLength": 1 },
        "SchemaVersion": { "type": "integer", "minimum": 1 },
        "Path": { "type": "string", "minLength": 1 },
        "Sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
