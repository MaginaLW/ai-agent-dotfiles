{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/secret-scan.schema.json",
  "title": "AI Agent Dotfiles Secret Scan Summary",
  "type": "object",
  "required": ["SchemaVersion", "GeneratedAtUtc", "Result", "Scanner", "GitleaksAvailable", "GitleaksFailed", "BlockingFindingCount", "HintCount", "Findings"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "GeneratedAtUtc": { "type": "string", "format": "date-time" },
    "Result": { "enum": ["PASS", "FAIL"] },
    "Scanner": { "enum": ["gitleaks-and-fallback", "fallback"] },
    "GitleaksAvailable": { "type": "boolean" },
    "GitleaksFailed": { "type": "boolean" },
    "BlockingFindingCount": { "type": "integer", "minimum": 0 },
    "HintCount": { "type": "integer", "minimum": 0 },
    "Findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["File", "Line", "Pattern"],
        "properties": {
          "File": { "type": "string" },
          "Line": { "type": "integer", "minimum": 1 },
          "Pattern": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
