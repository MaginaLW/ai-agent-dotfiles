{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/test-run-summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "ReportKind", "GeneratedAtUtc", "DiscoveryHash", "SetupAndNonSuiteBudgetSeconds", "MarginSeconds", "RequiredJobTimeoutSeconds", "Suites", "Counts", "Result"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "ReportKind": { "const": "test-run" },
    "GeneratedAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "DiscoveryHash": { "$ref": "#/$defs/sha256" },
    "SetupAndNonSuiteBudgetSeconds": { "type": "integer", "minimum": 1 },
    "MarginSeconds": { "type": "integer", "minimum": 1 },
    "RequiredJobTimeoutSeconds": { "type": "integer", "minimum": 1 },
    "Suites": { "type": "array", "items": { "$ref": "#/$defs/suite" } },
    "Counts": { "$ref": "#/$defs/counts" },
    "Result": { "enum": ["PASS", "FAIL"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SuiteId", "Path", "State", "Started", "Completed", "TimedOut", "TreeKilled", "TreeKillFailed", "ExitCode", "TimeoutSeconds", "DurationMilliseconds", "Stdout", "Stderr"],
      "properties": {
        "SuiteId": { "type": "string", "minLength": 1 },
        "Path": { "type": "string", "minLength": 1 },
        "State": { "enum": ["passed", "failed", "timed-out", "missing"] },
        "Started": { "type": "boolean" },
        "Completed": { "type": "boolean" },
        "TimedOut": { "type": "boolean" },
        "TreeKilled": { "type": "boolean" },
        "TreeKillFailed": { "type": "boolean" },
        "ExitCode": { "type": "integer" },
        "TimeoutSeconds": { "type": "integer", "minimum": 1 },
        "DurationMilliseconds": { "type": "integer", "minimum": 0 },
        "Stdout": { "type": "string" },
        "Stderr": { "type": "string" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Discovered", "Started", "Completed", "Passed", "Failed", "TimedOut", "Duplicate", "Missing", "TreeKillFailed"],
      "properties": {
        "Discovered": { "type": "integer", "minimum": 0 },
        "Started": { "type": "integer", "minimum": 0 },
        "Completed": { "type": "integer", "minimum": 0 },
        "Passed": { "type": "integer", "minimum": 0 },
        "Failed": { "type": "integer", "minimum": 0 },
        "TimedOut": { "type": "integer", "minimum": 0 },
        "Duplicate": { "type": "integer", "minimum": 0 },
        "Missing": { "type": "integer", "minimum": 0 },
        "TreeKillFailed": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
