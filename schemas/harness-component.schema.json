{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/harness-component.schema.json",
  "title": "Project Harness Component Output Contract",
  "type": "object",
  "required": ["SchemaVersion", "Id", "Kind", "TargetPlatforms", "Outputs"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "Id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "Kind": {
      "enum": ["Rule", "Prompt", "Command", "ClaudeAgent", "CodexPrompt", "CodexAgent", "ClaudeSettings", "OpenClawConfig"]
    },
    "TargetPlatforms": {
      "type": "array",
      "items": { "enum": ["Claude", "Codex", "OpenClaw"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "Requires": { "type": "array", "items": { "type": "string" } },
    "Conflicts": { "type": "array", "items": { "type": "string" } },
    "Outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["Target", "Mode"],
        "properties": {
          "Target": { "type": "string", "minLength": 1 },
          "Mode": { "enum": ["ManagedBlock", "GeneratedOnly", "DirectoryFiles", "StructuredMerge"] },
          "BlockId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "Source": { "type": "string", "pattern": "^(?!\\.{1,2}$)[^\\\\/:]+$" },
          "MergeStrategy": { "const": "JsonObject" }
        },
        "additionalProperties": false
      }
    },
    "Future": { "type": "object" }
  },
  "additionalProperties": false
}
