{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/canonical-setup-state.schema.json",
  "title": "Canonical Setup State",
  "type": "object",
  "required": [
    "SchemaVersion", "ArtifactKind", "RepoId", "ClaimId", "GitCommonDirHash",
    "OwnerSid", "SecurityResolverVersion", "SecurityTemplateHash",
    "CanonicalRecoveryRoot", "CanonicalRecoveryRootIntent", "CanonicalRecoveryRootIntentHash", "CanonicalRecoveryRootFinalContext", "CanonicalRecoveryRootFinalContextHash", "FilesystemCapabilityHash",
    "ControlBase", "ControlBaseIntent", "ControlBaseIntentHash", "ControlBaseFinalContext", "ControlBaseFinalContextHash",
    "BackupRoot", "BackupRootIntent", "BackupRootIntentHash", "BackupRootFinalContext", "BackupRootFinalContextHash",
    "SetupIntentHash", "SetupStateProjectionHash", "RootClaimHash"
  ],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "ArtifactKind": { "const": "canonical-setup-state" },
    "RepoId": { "$ref": "#/$defs/hash" },
    "ClaimId": { "$ref": "#/$defs/hash" },
    "GitCommonDirHash": { "$ref": "#/$defs/hash" },
    "OwnerSid": { "$ref": "#/$defs/sid" },
    "SecurityResolverVersion": { "const": "windows-token-sid-current-user-only-v1" },
    "SecurityTemplateHash": { "$ref": "#/$defs/hash" },
    "CanonicalRecoveryRoot": { "type": "string", "minLength": 3 },
    "CanonicalRecoveryRootIntent": { "$ref": "#/$defs/rootContext" },
    "CanonicalRecoveryRootIntentHash": { "$ref": "#/$defs/hash" },
    "CanonicalRecoveryRootFinalContext": { "$ref": "#/$defs/finalRootContext" },
    "CanonicalRecoveryRootFinalContextHash": { "$ref": "#/$defs/hash" },
    "FilesystemCapabilityHash": { "$ref": "#/$defs/hash" },
    "ControlBase": { "type": "string", "minLength": 3 },
    "ControlBaseIntent": { "$ref": "#/$defs/rootContext" },
    "ControlBaseIntentHash": { "$ref": "#/$defs/hash" },
    "ControlBaseFinalContext": { "$ref": "#/$defs/finalRootContext" },
    "ControlBaseFinalContextHash": { "$ref": "#/$defs/hash" },
    "BackupRoot": { "type": "string", "minLength": 3 },
    "BackupRootIntent": { "$ref": "#/$defs/rootContext" },
    "BackupRootIntentHash": { "$ref": "#/$defs/hash" },
    "BackupRootFinalContext": { "$ref": "#/$defs/finalRootContext" },
    "BackupRootFinalContextHash": { "$ref": "#/$defs/hash" },
    "SetupIntentHash": { "$ref": "#/$defs/hash" },
    "SetupStateProjectionHash": { "$ref": "#/$defs/hash" },
    "RootClaimHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sid": { "type": "string", "pattern": "^S-[0-9]+(?:-[0-9]+)+$" },
    "rootContext": {
      "type": "object",
      "required": ["ResolverVersion", "TargetStatus", "LocationKey", "RequestedPath", "VolumeId", "DeepestExistingParentPath", "DeepestExistingParentIdentity", "DeepestExistingParentOwnerSid", "DeepestExistingParentDaclHash", "MissingRemainder", "ExpectedFinalOwnerSid", "ExpectedFinalDaclTemplateHash", "FinalDirectoryIdentity", "FinalOwnerSid", "FinalDaclHash"],
      "properties": {
        "ResolverVersion": { "const": "windows-token-sid-current-user-only-v1" },
        "TargetStatus": { "enum": ["MISSING", "EXISTS"] },
        "LocationKey": { "type": "string", "minLength": 3 },
        "RequestedPath": { "type": "string", "minLength": 3 },
        "VolumeId": { "type": "string", "minLength": 1 },
        "DeepestExistingParentPath": { "type": "string", "minLength": 3 },
        "DeepestExistingParentIdentity": { "type": "string", "minLength": 1 },
        "DeepestExistingParentOwnerSid": { "$ref": "#/$defs/sid" },
        "DeepestExistingParentDaclHash": { "$ref": "#/$defs/hash" },
        "MissingRemainder": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "ExpectedFinalOwnerSid": { "$ref": "#/$defs/sid" },
        "ExpectedFinalDaclTemplateHash": { "$ref": "#/$defs/hash" },
        "FinalDirectoryIdentity": { "type": ["string", "null"] },
        "FinalOwnerSid": { "oneOf": [{ "$ref": "#/$defs/sid" }, { "type": "null" }] },
        "FinalDaclHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      },
      "oneOf": [
        { "properties": { "TargetStatus": { "const": "MISSING" }, "MissingRemainder": { "minItems": 1 }, "FinalDirectoryIdentity": { "type": "null" }, "FinalOwnerSid": { "type": "null" }, "FinalDaclHash": { "type": "null" } } },
        { "properties": { "TargetStatus": { "const": "EXISTS" }, "MissingRemainder": { "maxItems": 0 }, "FinalDirectoryIdentity": { "type": "string", "minLength": 1 }, "FinalOwnerSid": { "$ref": "#/$defs/sid" }, "FinalDaclHash": { "$ref": "#/$defs/hash" } } }
      ],
      "additionalProperties": false
    },
    "finalRootContext": {
      "allOf": [
        { "$ref": "#/$defs/rootContext" },
        { "properties": { "TargetStatus": { "const": "EXISTS" } } }
      ]
    }
  },
  "additionalProperties": false
}
