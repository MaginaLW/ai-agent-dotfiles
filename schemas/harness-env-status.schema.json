{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/harness-env-status.schema.json",
  "title": "AI Agent Dotfiles Harness Environment Status",
  "type": "object",
  "required": ["SchemaVersion", "GeneratedAtUtc", "Environments", "Active", "ProjectLinkage"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "GeneratedAtUtc": { "type": "string", "format": "date-time" },
    "Environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Name", "DefinitionStatus", "StagingStatus"],
        "properties": {
          "Name": { "type": "string" },
          "DefinitionStatus": { "enum": ["valid", "invalid"] },
          "StagingStatus": { "enum": ["missing", "stale", "built"] },
          "LockStatus": { "enum": ["not-checked", "valid", "invalid"] },
          "LockReasons": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "Active": {
      "type": "object",
      "required": ["Name", "Status"],
      "properties": {
        "Name": { "type": ["string", "null"] },
        "Status": { "enum": ["none", "active", "drift"] },
        "LockValidity": { "enum": ["not-checked", "valid", "invalid"] },
        "DefinitionDrift": { "type": "boolean" },
        "LiveParity": {
          "type": "object",
          "required": ["Status", "Mismatches"],
          "properties": {
            "Status": { "enum": ["not-checked", "pass", "mismatch"] },
            "Mismatches": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "SystemStatus": { "enum": ["not-checked", "not-present", "present-marker", "present-marker-missing"] },
        "BackupReference": { "type": ["string", "null"] },
        "LockHash": { "type": ["string", "null"] },
        "LockReasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "ProjectLinkage": { "enum": ["not-requested", "no-profile", "no-required-env", "missing-definition", "inactive", "matches-active", "mismatch"] }
  },
  "additionalProperties": false
}
