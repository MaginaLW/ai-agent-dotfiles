{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/mcp-plan.schema.json",
  "title": "Claude MCP Operation Plan",
  "type": "object",
  "required": ["SchemaVersion", "PlanKind", "TemplateId", "TemplateHash", "Action", "Scope", "Command", "Args", "EnvironmentVariables", "EnvironmentState", "MissingEnvironmentVariables", "CurrentServerExists", "CurrentServerHash", "PlanHash"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "PlanKind": { "const": "mcp-operation" },
    "TemplateId": { "type": "string" },
    "TemplateHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "Action": { "enum": ["add", "update", "remove", "noop"] },
    "Scope": { "const": "user" },
    "Command": { "type": "string" },
    "Args": { "type": "array", "items": { "type": "string" } },
    "EnvironmentVariables": { "type": "array", "items": { "type": "string" } },
    "EnvironmentState": { "type": "object", "additionalProperties": { "type": "object", "required": ["Present", "Hash"], "properties": { "Present": { "type": "boolean" }, "Hash": { "type": ["string", "null"] } }, "additionalProperties": false } },
    "MissingEnvironmentVariables": { "type": "array", "items": { "type": "string" } },
    "CurrentServerExists": { "type": "boolean" },
    "CurrentServerHash": { "type": ["string", "null"] },
    "GeneratedAtUtc": { "type": "string", "format": "date-time" },
    "PlanHash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
  },
  "additionalProperties": false
}
