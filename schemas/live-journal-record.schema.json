{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/live-journal-record.schema.json",
  "title": "AI Agent Dotfiles Live Transaction Journal Record",
  "type": "object",
  "required": ["SchemaVersion", "ArtifactKind", "TransactionId", "Sequence", "PreviousHash", "Phase", "Data"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "ArtifactKind": { "const": "live-journal-record" },
    "TransactionId": { "$ref": "#/$defs/uuid" },
    "Sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "PreviousHash": { "$ref": "#/$defs/hash" },
    "Phase": {
      "enum": [
        "DIR_CREATE_INTENT", "DIR_CREATED", "RECEIPT_COMPLETE", "PREPARED",
        "MOVE_OLD_INTENT", "OLD_MOVED", "MOVE_NEW_INTENT", "NEW_INSTALLED",
        "CLAIMS_PUBLISHED", "STATE_PREIMAGE_COMPLETE", "FILE_PREPARED",
        "FILE_REPLACE_INTENT", "FILE_REPLACED", "STATE_PUBLISHED",
        "POSTCONDITIONS_OK", "RECOVERY_ACTION_INTENT", "RECOVERY_ACTION_APPLIED", "COMPLETE"
      ]
    },
    "Data": { "$ref": "#/$defs/data" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "directoryIdentity": { "type": "string", "minLength": 25, "maxLength": 25, "pattern": "^[0-9a-f]{8}:[0-9a-f]{16}$" },
    "observed": {
      "oneOf": [
        { "type": "object", "required": ["State"], "properties": { "State": { "const": "MISSING" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["State", "Type", "Hash", "Identity"],
          "properties": {
            "State": { "const": "PRESENT" },
            "Type": { "enum": ["File", "Directory"] },
            "Hash": { "$ref": "#/$defs/hash" },
            "Identity": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "receiptRef": {
      "type": "object",
      "required": ["Id", "Path", "Hash"],
      "properties": {
        "Id": { "$ref": "#/$defs/uuid" },
        "Path": { "type": "string", "minLength": 4 },
        "Hash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "TargetId": { "$ref": "#/$defs/hash" },
        "TargetKind": { "enum": ["skill", "parent-directory", "state"] },
        "TargetPath": { "type": "string", "minLength": 4 },
        "PreimagePath": { "type": "string", "minLength": 4 },
        "SwapOldPath": { "type": "string", "minLength": 4 },
        "StagedPath": { "type": ["string", "null"] },
        "TargetState": { "$ref": "#/$defs/observed" },
        "PreimageState": { "$ref": "#/$defs/observed" },
        "SwapOldState": { "$ref": "#/$defs/observed" },
        "StagedState": { "$ref": "#/$defs/observed" },
        "CreatedIdentity": { "$ref": "#/$defs/directoryIdentity" },
        "ReceiptRef": { "$ref": "#/$defs/receiptRef" },
        "PostconditionsHash": { "$ref": "#/$defs/hash" },
        "ClaimsHash": { "$ref": "#/$defs/hash" },
        "StateHash": { "$ref": "#/$defs/hash" },
        "PreStatePhaseHash": { "$ref": "#/$defs/hash" },
        "PlanKind": { "enum": ["live-recover-abandon", "live-recover-rollback", "live-recover-finalize"] },
        "DocumentHash": { "$ref": "#/$defs/hash" },
        "PriorHeadHash": { "$ref": "#/$defs/hash" },
        "ExpectedTerminalProjectionHash": { "$ref": "#/$defs/hash" },
        "ExpectedOutcome": { "enum": ["committed", "abandoned", "rolled-back", "failed-restored"] },
        "Action": { "enum": ["abandon", "rollback", "finalize"] },
        "ResultHash": { "$ref": "#/$defs/hash" },
        "OriginalDocumentHash": { "$ref": "#/$defs/hash" },
        "Outcome": { "enum": ["committed", "abandoned", "rolled-back", "failed-restored"] },
        "ClosingKind": { "enum": ["original", "recovery"] },
        "ClosingDocumentHash": { "$ref": "#/$defs/hash" },
        "ClosingPlanKind": { "enum": ["live-recover-abandon", "live-recover-rollback", "live-recover-finalize"] },
        "RestorationHash": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
