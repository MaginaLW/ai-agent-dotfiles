{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-dotfiles.invalid/schemas/pending-prune-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["SchemaVersion", "ArtifactKind", "PlanPayload", "PlanHash", "DocumentHash"],
  "properties": {
    "SchemaVersion": { "const": 1 },
    "ArtifactKind": { "const": "pending-prune-plan" },
    "PlanPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["WorktreeNamespace", "SelectionTimestampUtc", "RegistrySnapshotHash", "Items"],
      "properties": {
        "WorktreeNamespace": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "SelectionTimestampUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "RegistrySnapshotHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "Items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["Path", "ContentHash"],
            "properties": {
              "Path": { "type": "string", "minLength": 3 },
              "ContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "PlanHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "DocumentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
