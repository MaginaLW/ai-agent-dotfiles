# Secrets and local credentials: use exact names or extensions only.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
auth.json
.credentials.json
id_rsa
id_ed25519
.ssh/

# Generated skills: build outputs, never committed.
claude/skills/
codex/skills/
reasonix/skills/

# Claude runtime and machine-local files.
claude/**/*.local.json
claude/projects/
claude/history*
claude/todos/
claude/statsig/
claude/shell-snapshots/
claude/logs/
claude/plugins/repos/
claude/agent-memory/
claude/ide/
claude/downloads/
claude/file-history/
claude/local/

# Codex runtime and machine-local files.
codex/**/*.local.toml
codex/sessions/
codex/log/
codex/cache/
codex/history.jsonl
codex/**/*.sqlite
codex/**/*.sqlite*
codex/volumes/

# Generated, backup, and temporary files.
backup/
tmp/
/.tmp-*
*.bak
*.tmp
.agent-harness/generated/
.agent-harness/backups/
**/.agent-harness/generated/
**/.agent-harness/backups/
/envs/
/state/

# Reasonix machine-local task state.
/.reasonix/tasks/
/.reasonix/desktop-topic-auto-title-meta.json
/.reasonix/desktop-topic-created-at.json
/.reasonix/desktop-topic-title-sources.json
/.reasonix/desktop-topic-titles.json

# Machine- and run-specific reports and sidecars; only documentation is tracked.
/reports/**
!reports/README.md

# Raw imported skills awaiting review.
imports/skills-inbox/**
imports/skills-quarantine/**
imports/skills-archive/**
imports/skills-reports/**

# Keep documentation placeholders only; generated import reports stay local.
!imports/
!imports/skills-inbox/
!imports/skills-inbox/README.md
!imports/skills-quarantine/
!imports/skills-quarantine/README.md
!imports/skills-archive/
!imports/skills-archive/README.md
!imports/skills-reports/
!imports/skills-reports/README.md
