# Secrets and local credentials: use exact names or extensions only.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
auth.json
.credentials.json
id_rsa
id_ed25519
.ssh/

# Generated skills: build outputs, never committed.
claude/skills/
codex/skills/
reasonix/skills/

# Claude runtime and machine-local files.
claude/**/*.local.json
claude/projects/
claude/history*
claude/todos/
claude/statsig/
claude/shell-snapshots/
claude/logs/
claude/plugins/repos/
claude/agent-memory/
claude/ide/
claude/downloads/
claude/file-history/
claude/local/

# Codex runtime and machine-local files.
codex/**/*.local.toml
codex/sessions/
codex/log/
codex/cache/
codex/history.jsonl
codex/**/*.sqlite
codex/**/*.sqlite*
codex/volumes/

# Generated, backup, and temporary files.
backup/
tmp/
/.tmp-*
*.bak
*.tmp
.agent-harness/generated/
.agent-harness/backups/
**/.agent-harness/generated/
**/.agent-harness/backups/
/envs/
/state/

# Reasonix machine-local task state.
/.reasonix/tasks/
/.reasonix/desktop-topic-auto-title-meta.json
/.reasonix/desktop-topic-created-at.json
/.reasonix/desktop-topic-title-sources.json
/.reasonix/desktop-topic-titles.json

# Retired run-report directory. Keep it ignored: scan-secrets.ps1 skips reports/.
/reports/

# Retired skill-import staging. Keep it ignored: scan-secrets.ps1 skips imports/.
/imports/
