# Secrets and local credentials: use exact names or extensions only.
.env
.env.*
*.key
*.pem
*.p12
*.pfx
auth.json
.credentials.json
id_rsa
id_ed25519
.ssh/

# Generated skills: build outputs, never committed.
codex/skills/

# Leftovers from older checkouts must stay untracked.
claude/skills/
zcode/skills/

# Claude Code agent worktrees (machine-local checkouts).
/.claude/worktrees/

# Claude runtime and machine-local files.
claude/**/*.local.json
claude/projects/
claude/history*
claude/todos/
claude/statsig/
claude/shell-snapshots/
claude/logs/
claude/plugins/repos/
claude/agent-memory/
claude/ide/
claude/downloads/
claude/file-history/
claude/local/

# Codex runtime and machine-local files.
codex/**/*.local.toml
codex/sessions/
codex/log/
codex/cache/
codex/history.jsonl
codex/**/*.sqlite*
codex/volumes/

# Antigravity runtime and machine-local files.
antigravity/config.json
antigravity/mcp_config.json
antigravity/import_manifest.json
antigravity/node_modules/
antigravity/plugins/
antigravity/projects/
antigravity/sidecars/

# Generated, backup, and temporary files.
backup/
tmp/
# Complete, unmodified local community checkouts kept alongside this repository.
/community-upstreams/
/.tmp-*
*.bak
*.tmp
**/.agent-harness/generated/
**/.agent-harness/backups/
